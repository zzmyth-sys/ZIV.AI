<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>ZivAiEditor.UI</RootNamespace>
  </PropertyGroup>

  <!-- UI is a pure view-model / rules library: no Avalonia, no Skia, no ZIV.* direct use.
       It only needs the frozen Contracts (the sole reference). Views live in ZivAiEditor.App. -->
  <ItemGroup>
    <ProjectReference Include="..\ZivAiEditor.Contracts\ZivAiEditor.Contracts.csproj" />
  </ItemGroup>

</Project>
