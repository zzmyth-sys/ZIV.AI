<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>ZivAiEditor.Diagnostics</RootNamespace>
  </PropertyGroup>

  <!-- Batch 2A / D1: opt-in diagnostics split out of Contracts to keep the contract layer
       behavior-free. It needs Contracts only for CropSpec (DescribeCrop); the dependency is
       one-way (Contracts never references Diagnostics). -->
  <ItemGroup>
    <ProjectReference Include="..\ZivAiEditor.Contracts\ZivAiEditor.Contracts.csproj" />
  </ItemGroup>

</Project>
