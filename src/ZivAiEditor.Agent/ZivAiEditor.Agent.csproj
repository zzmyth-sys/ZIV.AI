<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>ZivAiEditor.Agent</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ZivAiEditor.Contracts\ZivAiEditor.Contracts.csproj" />
    <ProjectReference Include="..\ZivAiEditor.Diagnostics\ZivAiEditor.Diagnostics.csproj" />
  </ItemGroup>

  <!-- Bridge §4.2 / §7.3: the editor App consumes the internal PathNormalizer for the
       image source-image reverse lookup; the helper stays internal (not a public contract). -->
  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>ZivAiEditor.App</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

</Project>
