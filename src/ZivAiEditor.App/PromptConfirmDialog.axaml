<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="ZivAiEditor.App.PromptConfirmDialog"
        Title="ZIV.AI Editor"
        Width="560"
        Height="360"
        CanResize="False"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        WindowDecorations="None"
        ExtendClientAreaToDecorationsHint="True"
        Background="Transparent"
        TransparencyLevelHint="Transparent"
        TransparencyBackgroundFallback="#FF1A1A1A">
  <Border Background="{StaticResource ZivBackgroundBrush}"
          BorderBrush="#3A3A3A"
          BorderThickness="1"
          CornerRadius="8">
    <Grid RowDefinitions="Auto,*,Auto" Margin="16">
      <TextBlock Grid.Row="0"
                 TextWrapping="Wrap"
                 Margin="0,0,0,10"
                 Foreground="{StaticResource ZivTextBrush}"
                 Text="扩写后的提示词：" />
      <ScrollViewer Grid.Row="1">
        <TextBox x:Name="PART_Prompt"
                 IsReadOnly="True"
                 AcceptsReturn="True"
                 TextWrapping="Wrap"
                 VerticalAlignment="Top"
                 MinHeight="180" />
      </ScrollViewer>
      <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,10,0,0">
        <Button x:Name="PART_Cancel" Content="取消" MinWidth="80" Height="32" />
        <Button x:Name="PART_Rewrite" Content="重写" MinWidth="80" Height="32" />
        <Button x:Name="PART_Confirm" Content="确定" MinWidth="80" Height="32"
                Background="#3A6DF0" Foreground="White" />
      </StackPanel>
    </Grid>
  </Border>
</Window>