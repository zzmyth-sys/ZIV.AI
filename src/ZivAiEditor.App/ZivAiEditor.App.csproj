<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>ZivAiEditor.App</RootNamespace>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>

    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishAot>true</PublishAot>
    <PublishSingleFile Condition="'$(PublishAot)' != 'true'">true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <ApplicationIcon>Assets\logo.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ZivAiEditor.UI\ZivAiEditor.UI.csproj" />
    <ProjectReference Include="..\ZivAiEditor.Backend\ZivAiEditor.Backend.csproj" />
    <ProjectReference Include="..\ZivAiEditor.Agent\ZivAiEditor.Agent.csproj" />
    <ProjectReference Include="..\ZivAiEditor.Tools\ZivAiEditor.Tools.csproj" />
    <ProjectReference Include="..\ZivAiEditor.Contracts\ZivAiEditor.Contracts.csproj" />
    <ProjectReference Include="..\ZivAiEditor.Diagnostics\ZivAiEditor.Diagnostics.csproj" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
  </ItemGroup>

  <ItemGroup>
    <!-- B2: ship the seed template, not the repo-root settings.ini (which may hold dev-machine
         paths). The program-directory settings.ini is created on first launch by
         SettingsLoader.EnsurePresent. -->
    <None Include="..\..\settings.ini.template" Link="settings.ini.template" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\Template\commands.json" Link="Template\commands.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\Template\loras.json" Link="Template\loras.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\Template\models.json" Link="Template\models.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\Template\plugins.json" Link="Template\plugins.json" CopyToOutputDirectory="PreserveNewest" />

    <!-- ZIV.AI's own backend pipeline ships with the app (first-party, ~125 KB). ComfyUI /
         python_embeded / model weights are third-party and supplied by the user (RELEASE §2);
         they are NOT bundled. This makes the default [backend] script
         (<program>\python\server\main.py) point at a real file. Test scripts are excluded. -->
    <None Include="..\..\python\server\**\*.py"
          Exclude="..\..\python\server\test_*.py"
          Link="python\server\%(RecursiveDir)%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- App logo (window / title-bar icon). The .ico is the Win32 exe icon. -->
  <ItemGroup>
    <AvaloniaResource Include="Assets\logo.png" />
  </ItemGroup>

  <!-- Step 9A: let the test project exercise the App-layer single-instance guard
       (Mutex + Named Pipe live only in the App platform layer, Z4). -->
  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>ZivAiEditor.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\ZivAiEditor.Imaging\ZivAiEditor.Imaging.csproj" />
  </ItemGroup>

</Project>
