<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>ZivAiEditor.App</RootNamespace>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>

    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishAot>true</PublishAot>
    <PublishSingleFile Condition="'$(PublishAot)' != 'true'">true</PublishSingleFile>
    <SelfContained>true</SelfContained>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ZivAiEditor.UI\ZivAiEditor.UI.csproj" />
    <ProjectReference Include="..\ZivAiEditor.Backend\ZivAiEditor.Backend.csproj" />
    <ProjectReference Include="..\ZivAiEditor.Agent\ZivAiEditor.Agent.csproj" />
    <ProjectReference Include="..\ZivAiEditor.Tools\ZivAiEditor.Tools.csproj" />
    <ProjectReference Include="..\ZivAiEditor.Contracts\ZivAiEditor.Contracts.csproj" />
    <ProjectReference Include="..\..\..\ZIV\src\ZIV.Core\ZIV.Core.csproj" />
    <ProjectReference Include="..\..\..\ZIV\src\ZIV.Imaging\ZIV.Imaging.csproj" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="UVtools.AvaloniaControls" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\settings.ini" Link="settings.ini" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\Template\commands.json" Link="Template\commands.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Step 9A: let the test project exercise the App-layer single-instance guard
       (Mutex + Named Pipe live only in the App platform layer, Z4). -->
  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>ZivAiEditor.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

</Project>
