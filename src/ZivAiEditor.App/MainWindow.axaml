<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:ZivAiEditor.App.Controls"
        x:Class="ZivAiEditor.App.MainWindow"
        Title="ZIV.AI Editor"
        Width="1040"
        Height="700"
        MinWidth="760"
        MinHeight="500"
        ExtendClientAreaToDecorationsHint="True"
        WindowDecorations="None"
        TransparencyLevelHint="Transparent"
        TransparencyBackgroundFallback="#FF1A1A1A"
        Background="Transparent">

  <Window.Styles>
    <Style Selector="ListBoxItem">
      <Setter Property="Padding" Value="10,6" />
      <Setter Property="CornerRadius" Value="4" />
    </Style>
  </Window.Styles>

  <c:ChromeTitleBar x:Name="PART_Chrome">
    <c:ChromeTitleBar.LeftContent>
      <TextBlock Text="ZIV.AI Editor"
                 Margin="12,0"
                 VerticalAlignment="Center"
                 Foreground="{StaticResource ZivTextBrush}"
                 FontWeight="SemiBold"
                 TextTrimming="CharacterEllipsis" />
    </c:ChromeTitleBar.LeftContent>
    <c:ChromeTitleBar.Body>
      <DockPanel>
          <!-- Bottom input + status -->
          <Border DockPanel.Dock="Bottom" Background="{StaticResource ZivTitleBarBrush}" Padding="12,10">
            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
              <TextBox x:Name="PART_Input"
                       Grid.Row="0"
                       Grid.Column="0"
                       MinHeight="40"
                       AcceptsReturn="False"
                       PlaceholderText="输入编辑指令，例如 /换背景 茶肆 或 把天空换成日落"
                       Background="#2A2A2A"
                       Foreground="{StaticResource ZivTextBrush}"
                       BorderBrush="#3A3A3A" />
              <Button x:Name="PART_BtnSend"
                      Grid.Row="0"
                      Grid.Column="1"
                      Margin="8,0,0,0"
                      MinWidth="72"
                      Height="40"
                      Background="#3A6DF0"
                      Foreground="White"
                      Content="发送" />
              <TextBlock x:Name="PART_Status"
                         Grid.Row="1"
                         Grid.Column="0"
                         Grid.ColumnSpan="2"
                         Margin="0,6,0,0"
                         Foreground="{StaticResource ZivTextSecondaryBrush}"
                         Text="就绪"
                         TextTrimming="CharacterEllipsis" />
            </Grid>
          </Border>

          <Grid ColumnDefinitions="240,*">
            <!-- History node list (tree, ParentNodeId indentation) -->
            <Border Grid.Column="0" Background="#202020" BorderBrush="#2E2E2E" BorderThickness="0,0,1,0">
              <Grid RowDefinitions="Auto,*">
                <TextBlock Grid.Row="0"
                           Margin="12,10"
                           Foreground="{StaticResource ZivTextSecondaryBrush}"
                           Text="历史节点" />
                <ListBox x:Name="PART_HistoryList"
                         Grid.Row="1"
                         Background="Transparent"
                         BorderThickness="0"
                         SelectionMode="Single" />
              </Grid>
            </Border>

            <!-- Chat stream -->
            <ScrollViewer x:Name="PART_ChatScroll" Grid.Column="1" Padding="12">
              <StackPanel x:Name="PART_ChatStream" Spacing="8" />
            </ScrollViewer>
          </Grid>
        </DockPanel>
    </c:ChromeTitleBar.Body>
  </c:ChromeTitleBar>
</Window>
