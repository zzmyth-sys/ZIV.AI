<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:ZivAiEditor.App.Controls"
        x:Class="ZivAiEditor.App.MainWindow"
        Title="ZIV.AI Editor"
        Icon="avares://ZivAiEditor.App/Assets/logo.png"
        Width="1040"
        Height="700"
        MinWidth="760"
        MinHeight="500"
        ExtendClientAreaToDecorationsHint="True"
        WindowDecorations="None"
        TransparencyLevelHint="Transparent"
        TransparencyBackgroundFallback="#FF1A1A1A"
        Background="Transparent">

  <Window.Styles>
    <Style Selector="ListBoxItem">
      <Setter Property="Padding" Value="10,6" />
      <Setter Property="CornerRadius" Value="4" />
    </Style>
  </Window.Styles>

  <Panel>
  <c:ChromeTitleBar x:Name="PART_Chrome">
    <c:ChromeTitleBar.LeftContent>
      <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
        <TextBlock Text="ZIV.AI Editor"
                   Margin="6,0,0,0"
                   VerticalAlignment="Center"
                   Foreground="{StaticResource ZivTextBrush}"
                   FontWeight="SemiBold"
                   TextTrimming="CharacterEllipsis" />
        <Button x:Name="PART_BtnNewProject" Classes="tool" Margin="8,0,0,0" ToolTip.Tip="新建项目">
          <Path Classes="toolIcon" Data="{StaticResource IconPlus}" />
        </Button>
        <Button x:Name="PART_BtnSave" Classes="tool" ToolTip.Tip="保存项目 (Ctrl+S)">
          <Path Classes="toolIcon" Data="{StaticResource IconSave}" />
        </Button>
      </StackPanel>
    </c:ChromeTitleBar.LeftContent>
    <c:ChromeTitleBar.RightContent>
      <Button x:Name="PART_BtnToggleSidebar" Classes="tool" ToolTip.Tip="历史节点">
        <Path Classes="toolIcon" Data="{StaticResource IconSidebar}" />
      </Button>
    </c:ChromeTitleBar.RightContent>
    <c:ChromeTitleBar.Body>
      <!-- Two columns: the history pane spans the full height (title bar to the
           window bottom); the input area lives only in the right (chat) column. -->
      <Grid ColumnDefinitions="Auto,*">
        <!-- History node list (tree, ParentNodeId indentation); toggled from the
             title bar's sidebar button. -->
        <Border x:Name="PART_HistoryPane"
                Grid.Column="0"
                Width="240"
                Background="#202020"
                BorderBrush="#2E2E2E"
                BorderThickness="0,0,1,0">
          <Grid RowDefinitions="Auto,*,Auto,*">
            <TextBlock Grid.Row="0"
                       Margin="12,10"
                       Foreground="{StaticResource ZivTextSecondaryBrush}"
                       Text="项目" />
            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
              <StackPanel x:Name="PART_ProjectList" Spacing="2" Margin="6,0" />
            </ScrollViewer>
            <TextBlock Grid.Row="2"
                       Margin="12,10"
                       Foreground="{StaticResource ZivTextSecondaryBrush}"
                       Text="历史节点" />
            <ListBox x:Name="PART_HistoryList"
                     Grid.Row="3"
                     Background="Transparent"
                     BorderThickness="0"
                     SelectionMode="Single" />
          </Grid>
        </Border>

        <DockPanel Grid.Column="1">
          <!-- Bottom input + status. Centered, capped width (does not span the whole
               window), rounded to match the window chrome (CornerRadius 8). -->
          <Border DockPanel.Dock="Bottom" Background="{StaticResource ZivBackgroundBrush}" Padding="12,10">
            <Grid MaxWidth="570" RowDefinitions="Auto,Auto" HorizontalAlignment="Stretch">
              <c:ImageImportBar x:Name="PART_ImportBar"
                                Grid.Row="0"
                                Margin="0,0,0,8" />
              <!-- Input container (opencode / DeepSeek style): text on top, a tool row
                   below with + / send. -->
              <Border Grid.Row="1"
                      x:Name="PART_InputBox"
                      Background="#1E1E1E"
                      BorderBrush="#333333"
                      BorderThickness="1"
                      CornerRadius="12"
                      Padding="12,10">
                <Grid RowDefinitions="Auto,Auto">
                  <TextBox x:Name="PART_Input"
                           Grid.Row="0"
                           Classes="plainInput"
                           MinHeight="56"
                           MaxHeight="180"
                           AcceptsReturn="True"
                           TextWrapping="Wrap"
                           VerticalContentAlignment="Top"
                           PlaceholderText="输入编辑指令（Enter 发送，Shift+Enter 换行）…"
                           Foreground="{StaticResource ZivTextBrush}" />
                  <Grid Grid.Row="1" ColumnDefinitions="Auto,Auto,Auto,*,Auto" Margin="0,6,0,0">
                    <Button x:Name="PART_BtnAddImage"
                            Grid.Column="0"
                            Classes="oc"
                            ToolTip.Tip="添加图片">
                      <Path Classes="toolIcon" Width="12" Height="12" Data="{StaticResource IconPlus}" />
                    </Button>
                    <c:ResolutionPicker x:Name="PART_ResolutionPicker"
                                        Grid.Column="1"
                                        Margin="6,0,0,0"
                                        VerticalAlignment="Center" />
                    <Button x:Name="PART_BtnMode"
                            Grid.Column="2"
                            Classes="oc"
                            Width="NaN"
                            MinWidth="34"
                            Padding="8,0"
                            Margin="6,0,0,0"
                            ToolTip.Tip="编辑模式">
                      <TextBlock x:Name="PART_ModeLabel"
                                 Text="单图"
                                 FontSize="11"
                                 VerticalAlignment="Center"
                                 Foreground="{StaticResource ZivTextSecondaryBrush}" />
                    </Button>
                    <TextBlock x:Name="PART_ModeHint" Grid.Column="3" Margin="8,0" VerticalAlignment="Center" FontSize="11" Foreground="#E06C4A" IsVisible="False" TextWrapping="NoWrap" />
                    <Button x:Name="PART_BtnSend"
                            Grid.Column="4"
                            Classes="ocSend"
                            ToolTip.Tip="发送">
                      <Path Classes="sendIcon" Data="{StaticResource IconArrowUp}" />
                    </Button>
                  </Grid>
                  <!-- / command suggestion list (T5/S4): anchored to PART_Input, opened and
                       driven by MainWindow.CommandList.cs. The rows are non-focusable so the
                       input keeps focus; keys are handled in PART_Input's tunnel handler. -->
                  <Popup x:Name="PART_CommandPopup" Grid.Row="1" Placement="Bottom">
                    <Border x:Name="PART_CommandPopupHost"
                            Background="#252525"
                            BorderBrush="#3A3A3A"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="4">
                      <ScrollViewer MaxHeight="200"
                                    VerticalScrollBarVisibility="Auto"
                                    HorizontalScrollBarVisibility="Disabled">
                        <StackPanel x:Name="PART_CommandList" />
                      </ScrollViewer>
                    </Border>
                  </Popup>
                </Grid>
              </Border>
            </Grid>
          </Border>

          <!-- Chat stream -->
          <ScrollViewer x:Name="PART_ChatScroll" Padding="12">
            <StackPanel x:Name="PART_ChatStream" Spacing="8" />
          </ScrollViewer>
        </DockPanel>
      </Grid>
    </c:ChromeTitleBar.Body>
  </c:ChromeTitleBar>

    <!-- F6: dim the whole client area (title bar included) while the preview window is
         open. Purely visual — the disable logic is F5.1 — so it never intercepts input.
         Rounded to match the chrome root; opacity is #80000000 (50% black). -->
    <Border x:Name="PART_ModalDim"
            Background="#80000000"
            CornerRadius="8"
            IsVisible="False"
            IsHitTestVisible="False"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch" />
  </Panel>
</Window>