<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="ZivAiEditor.App.App"
             RequestedThemeVariant="Default">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://ZivAiEditor.App/Themes/ZivColors.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>
  <Application.Styles>
    <FluentTheme />
    <!-- AdvancedImageBox theme (UVtools.AvaloniaControls) for the image preview. -->
    <StyleInclude Source="avares://UVtools.AvaloniaControls/Controls.axaml" />
    <StyleInclude Source="avares://ZivAiEditor.App/Styles/ChromeStyles.axaml" />
  </Application.Styles>
</Application>
