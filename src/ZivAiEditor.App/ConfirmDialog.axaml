<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="ZivAiEditor.App.ConfirmDialog"
        Title="ZIV.AI Editor"
        Width="380"
        Height="170"
        CanResize="False"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        WindowDecorations="None"
        ExtendClientAreaToDecorationsHint="True"
        Background="Transparent"
        TransparencyLevelHint="Transparent"
        TransparencyBackgroundFallback="#FF1A1A1A">
  <Border Background="{StaticResource ZivBackgroundBrush}"
          BorderBrush="#3A3A3A"
          BorderThickness="1"
          CornerRadius="8">
    <Grid RowDefinitions="*,Auto" Margin="16">
      <TextBlock x:Name="PART_Message"
                 Grid.Row="0"
                 VerticalAlignment="Center"
                 TextWrapping="Wrap"
                 Foreground="{StaticResource ZivTextBrush}"
                 Text="保存本次会话？" />
      <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
        <Button x:Name="PART_No" Content="否" MinWidth="80" Height="32" />
        <Button x:Name="PART_Yes" Content="是" MinWidth="80" Height="32"
                Background="#3A6DF0" Foreground="White" />
      </StackPanel>
    </Grid>
  </Border>
</Window>
