<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- ZIV.AI palette copied from ZIV (ZIV/src/ZIV.App/MainWindow.axaml) so the two
       apps look identical. ZIV.AI intentionally does not reference any ZIV control;
       only these constant values are duplicated. -->
  <SolidColorBrush x:Key="ZivBackgroundBrush" Color="#1A1A1A" />
  <SolidColorBrush x:Key="ZivTitleBarBrush" Color="#252525" />
  <SolidColorBrush x:Key="ZivTextBrush" Color="#DDDDDD" />
  <SolidColorBrush x:Key="ZivTextSecondaryBrush" Color="#AAAAAA" />
  <SolidColorBrush x:Key="ZivButtonHoverBrush" Color="#33FFFFFF" />
  <SolidColorBrush x:Key="ZivButtonPressedBrush" Color="#22FFFFFF" />
  <SolidColorBrush x:Key="ZivCloseHoverBrush" Color="#C42B1C" />
  <SolidColorBrush x:Key="ZivClosePressedBrush" Color="#B0241A" />
  <SolidColorBrush x:Key="ZivCanvasBackgroundBrush" Color="#161616" />
  <SolidColorBrush x:Key="ZivOverlayBrush" Color="#99000000" />

</ResourceDictionary>
