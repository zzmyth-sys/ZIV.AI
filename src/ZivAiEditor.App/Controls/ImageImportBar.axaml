<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="ZivAiEditor.App.Controls.ImageImportBar">
  <!-- Attachment strip (Step 9C.3, web-chat style): hidden by default, it pops up
       above the input box only once images are dragged in / picked. Thumbnails are
       built in code-behind; the control is platform-light (the picker and OS
       drag-drop live in MainWindow). -->
  <UserControl.Styles>
    <Style Selector="Rectangle.thumbFrame">
      <Setter Property="Width" Value="72" />
      <Setter Property="Height" Value="72" />
      <Setter Property="RadiusX" Value="6" />
      <Setter Property="RadiusY" Value="6" />
      <Setter Property="Stroke" Value="#3A3A3A" />
      <Setter Property="StrokeThickness" Value="1" />
      <Setter Property="StrokeDashArray" Value="3,3" />
      <Setter Property="Fill" Value="#202020" />
    </Style>

    <Style Selector="Button.remove">
      <Setter Property="Width" Value="18" />
      <Setter Property="Height" Value="18" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Background" Value="#CC000000" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="9" />
      <Setter Property="IsVisible" Value="False" />
      <Setter Property="HorizontalAlignment" Value="Right" />
      <Setter Property="VerticalAlignment" Value="Top" />
      <Setter Property="Margin" Value="0,2,2,0" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Panel.thumb:pointerover Button.remove">
      <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector="Button.remove:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource ZivCloseHoverBrush}" />
    </Style>
    <Style Selector="Path.removeIcon">
      <Setter Property="Width" Value="9" />
      <Setter Property="Height" Value="9" />
      <Setter Property="Stretch" Value="Uniform" />
      <Setter Property="Stroke" Value="White" />
      <Setter Property="StrokeThickness" Value="1.6" />
      <Setter Property="StrokeLineCap" Value="Round" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
  </UserControl.Styles>

  <ScrollViewer x:Name="PART_Scroll"
                HorizontalScrollBarVisibility="Auto"
                VerticalScrollBarVisibility="Disabled"
                Height="80"
                IsVisible="False">
    <StackPanel x:Name="PART_Items" Orientation="Horizontal" Spacing="8" Margin="0,2" />
  </ScrollViewer>
</UserControl>