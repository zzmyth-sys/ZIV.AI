<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:ZivAiEditor.App.Controls"
        xmlns:m="clr-namespace:ZivAiEditor.App.Controls.Modes"
        x:Class="ZivAiEditor.App.Controls.ImagePreview"
        Title="ZIV.AI - 大图预览"
        Icon="avares://ZivAiEditor.App/Assets/logo.png"
        Width="900"
        Height="640"
        MinWidth="360"
        MinHeight="280"
        WindowStartupLocation="CenterOwner"
        ExtendClientAreaToDecorationsHint="True"
        WindowDecorations="None"
        TransparencyLevelHint="Transparent"
        TransparencyBackgroundFallback="#FF1A1A1A"
        Background="Transparent">

  <!-- Large-image preview window (Step 9C.1), opened by clicking an image in the chat
       stream. It reuses the same self-drawn chrome as MainWindow (no OS title bar).
       The PanZoomCanvas only renders; all zoom / pan state lives in
       ZivAiEditor.UI.Imaging.ImageViewModel and is applied here (Z4). -->
  <c:ChromeTitleBar x:Name="PART_Chrome">
    <c:ChromeTitleBar.LeftContent>
      <c:EditorToolbar x:Name="PART_Toolbar" />
    </c:ChromeTitleBar.LeftContent>
    <c:ChromeTitleBar.CenterContent>
      <TextBlock x:Name="PART_TitleText"
                 Foreground="{StaticResource ZivTextBrush}"
                 TextTrimming="CharacterEllipsis"
                 IsHitTestVisible="False" />
    </c:ChromeTitleBar.CenterContent>
    <c:ChromeTitleBar.RightContent>
      <StackPanel Orientation="Horizontal" Spacing="2" Margin="0,0,4,0" VerticalAlignment="Center">
        <Button x:Name="PART_BtnResetView" Classes="tool" ToolTip.Tip="重置视图">
          <Path Classes="toolIcon" Data="{StaticResource IconZoomReset}" />
        </Button>
        <ToggleButton x:Name="PART_BtnCompare" Classes="tool"
                      ToolTip.Tip="划像对比（父图 / 当前图）" IsEnabled="False">
          <Path Classes="toolIcon" Data="{StaticResource IconCompare}" />
        </ToggleButton>
        <Button x:Name="PART_BtnSave" Classes="tool" ToolTip.Tip="另存为 (Ctrl+Shift+S)">
          <Path Classes="toolIcon" Data="{StaticResource IconSave}" />
        </Button>
      </StackPanel>
    </c:ChromeTitleBar.RightContent>
    <c:ChromeTitleBar.Body>
      <!-- Image content -->
      <Grid Background="{StaticResource ZivCanvasBackgroundBrush}">
        <c:PanZoomCanvas x:Name="PART_ImageCanvas" />

        <c:CompareOverlay x:Name="PART_Compare"
                          BackgroundFill="{StaticResource ZivCanvasBackgroundBrush}"
                          IsVisible="False" />

        <!-- Crop overlay (Step 9C.4). The crop chrome is CropModePanel (N4) below. -->
        <c:CropOverlay x:Name="PART_CropOverlay" IsVisible="False" />

        <!-- Mask overlay (Step 9C.7): semi-transparent red where painted. -->
        <c:MaskOverlay x:Name="PART_MaskOverlay" IsVisible="False" />

        <!-- Mode chrome (N4): dumb panels that raise events and render pushed state; hidden
             unless their tool is active. They are hit-test-visible only on their bars, so
             pan / zoom still works everywhere else. -->
        <m:CropModePanel x:Name="PART_CropPanel" IsVisible="False" />
        <m:MaskModePanel x:Name="PART_MaskPanel" IsVisible="False" />

        <Border x:Name="PART_CropToast"
                Margin="8"
                Padding="8,4"
                CornerRadius="6"
                Background="{StaticResource ZivOverlayBrush}"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                IsVisible="False">
          <TextBlock x:Name="PART_CropToastText"
                     FontSize="12"
                     Foreground="{StaticResource ZivTextBrush}" />
        </Border>

        <TextBlock x:Name="PART_Empty"
                   Text="暂无图像"
                   Foreground="{StaticResource ZivTextSecondaryBrush}"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center" />

        <Border x:Name="PART_ZoomBadge"
                Margin="8"
                Padding="6,2"
                CornerRadius="4"
                Background="{StaticResource ZivOverlayBrush}"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                IsVisible="False">
          <TextBlock x:Name="PART_ZoomText"
                     Text="适配"
                     FontSize="11"
                     Foreground="{StaticResource ZivTextBrush}" />
        </Border>

        <!-- Image pixel size, bottom-right (same style as the zoom badge). -->
        <Border x:Name="PART_SizeBadge"
                Margin="8"
                Padding="6,2"
                CornerRadius="4"
                Background="{StaticResource ZivOverlayBrush}"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                IsVisible="False">
          <TextBlock x:Name="PART_SizeText"
                     FontSize="11"
                     Foreground="{StaticResource ZivTextBrush}" />
        </Border>

        <!-- Reference (parent) image size, bottom-left, shown only in compare mode. -->
        <Border x:Name="PART_CompareInfo"
                Margin="8"
                Padding="6,2"
                CornerRadius="4"
                Background="{StaticResource ZivOverlayBrush}"
                HorizontalAlignment="Left"
                VerticalAlignment="Bottom"
                IsVisible="False">
          <TextBlock x:Name="PART_CompareInfoText"
                     FontSize="11"
                     Foreground="{StaticResource ZivTextBrush}" />
        </Border>
      </Grid>
    </c:ChromeTitleBar.Body>
  </c:ChromeTitleBar>
</Window>
