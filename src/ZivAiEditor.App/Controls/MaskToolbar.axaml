<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="ZivAiEditor.App.Controls.MaskToolbar">
  <!-- Floating mask toolbar (Step 9C.7-B): brush size + feather, top-center over the image.
       It sits above the AdvancedImageBox in the Body Grid and stays hit-test-visible, but
       ImagePreview registers its own pointer handlers so the panel does not leak clicks to
       image pan / zoom. -->
  <Border Padding="10,6"
          CornerRadius="6"
          Background="{StaticResource ZivOverlayBrush}"
          VerticalAlignment="Top">
    <StackPanel Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
      <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
        <TextBlock Text="笔刷"
                   Foreground="{StaticResource ZivTextBrush}"
                   VerticalAlignment="Center" />
        <Slider x:Name="PART_BrushSlider"
                Width="140"
                Minimum="5"
                Maximum="200"
                Value="40"
                TickFrequency="1"
                IsSnapToTickEnabled="True"
                VerticalAlignment="Center" />
        <TextBlock x:Name="PART_BrushValue"
                   MinWidth="28"
                   Text="40"
                   Foreground="{StaticResource ZivTextBrush}"
                   VerticalAlignment="Center" />
      </StackPanel>

      <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
        <TextBlock Text="羽化"
                   Foreground="{StaticResource ZivTextBrush}"
                   VerticalAlignment="Center" />
        <Slider x:Name="PART_FeatherSlider"
                Width="120"
                Minimum="0"
                Maximum="25"
                Value="0"
                TickFrequency="1"
                IsSnapToTickEnabled="True"
                VerticalAlignment="Center" />
        <TextBlock x:Name="PART_FeatherValue"
                   MinWidth="22"
                   Text="0"
                   Foreground="{StaticResource ZivTextBrush}"
                   VerticalAlignment="Center" />
      </StackPanel>

      <TextBlock Text="羽化过大会削弱编辑强度"
                 FontSize="11"
                 Foreground="{StaticResource ZivTextSecondaryBrush}"
                 VerticalAlignment="Center" />
    </StackPanel>
  </Border>
</UserControl>