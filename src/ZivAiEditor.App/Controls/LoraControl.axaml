<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="ZivAiEditor.App.Controls.LoraControl">
  <!-- Command-level LoRA control (MVP): a small Button that opens a Flyout with the toggle,
       strength slider and weight path (auto-saved on Flyout close). Shown only for commands whose effective LoRA
       list is non-empty (today /换脸). The Flyout content is built eagerly in the code-behind
       (mirrors ResolutionPicker), so its state is readable without opening the Flyout. -->
  <Button x:Name="PART_Btn"
          Background="Transparent"
          BorderThickness="0"
          Padding="6,0"
          Height="24"
          CornerRadius="6"
          Cursor="Hand">
    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
      <Path Classes="modelIcon" Data="{StaticResource IconSparkle}" />
      <TextBlock x:Name="PART_Label"
                 FontSize="12"
                 VerticalAlignment="Center"
                 Foreground="{StaticResource ZivTextSecondaryBrush}" />
      <Path Classes="chevronIcon" Data="{StaticResource IconChevronDown}">
        <Path.RenderTransform>
          <TranslateTransform Y="2" />
        </Path.RenderTransform>
      </Path>
    </StackPanel>
  </Button>
</UserControl>
