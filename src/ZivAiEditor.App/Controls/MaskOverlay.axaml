<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="ZivAiEditor.App.Controls.MaskOverlay">
  <!-- Self-drawn mask overlay (Step 9C.7). Render() blits a display-only bitmap of the
       mask buffer (semi-transparent red where painted) through the shared ImageViewModel
       transform so it stays pixel-aligned through pan / zoom. It is hit-test-invisible:
       the ImagePreview routes pointer input. No template children are needed. -->
  <Grid />
</UserControl>
