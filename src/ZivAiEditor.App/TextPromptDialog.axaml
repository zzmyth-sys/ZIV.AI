<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="ZivAiEditor.App.TextPromptDialog"
        Title="ZIV.AI Editor"
        Width="380"
        Height="180"
        CanResize="False"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        WindowDecorations="None"
        ExtendClientAreaToDecorationsHint="True"
        Background="Transparent"
        TransparencyLevelHint="Transparent"
        TransparencyBackgroundFallback="#FF1A1A1A">
  <Border Background="{StaticResource ZivBackgroundBrush}"
          BorderBrush="#3A3A3A"
          BorderThickness="1"
          CornerRadius="8">
    <Grid RowDefinitions="Auto,Auto,*" Margin="16">
      <TextBlock x:Name="PART_Message"
                 Grid.Row="0"
                 TextWrapping="Wrap"
                 Foreground="{StaticResource ZivTextBrush}"
                 Text="重命名项目" />
      <TextBox x:Name="PART_Input"
               Grid.Row="1"
               Margin="0,10,0,0" />
      <StackPanel Grid.Row="2"
                  Orientation="Horizontal"
                  HorizontalAlignment="Right"
                  VerticalAlignment="Bottom"
                  Spacing="8">
        <Button x:Name="PART_Cancel" Content="取消" MinWidth="80" Height="32" />
        <Button x:Name="PART_Ok" Content="确定" MinWidth="80" Height="32"
                Background="#3A6DF0" Foreground="White" />
      </StackPanel>
    </Grid>
  </Border>
</Window>
