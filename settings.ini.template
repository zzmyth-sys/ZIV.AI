; ZIV.AI settings (template)
; 运行时程序目录下的 settings.ini 由此模板部署（见 DOC/ARCHITECTURE.md §8 Z14）。
; settings.ini 本身被 .gitignore 忽略；本模板入库，供新环境初始化。

[backend]
pipe_name = zivai.infer.v1
; 由设置窗口填入绝对路径；留空表示未配置（A9：不再硬编码开发机路径）。
python_exe =
script =
; 启动预热（优化 §10.2.1）：App 启动时后台拉起 Python 后端，让 import comfy/DynamicVRAM init
; 在用户准备期间完成，首次生成可省 ~5 s。1=开（默认），0=改为首次使用时惰性启动。
prewarm = 1

[models]
; 模型三件套权重路径（A2）；由设置窗口填入绝对路径，留空表示回退 models.json / 内置默认。
dit_path =
te_path =
vae_path =

; 规划器（Planner）使用的本地 LLM（llama-server，OpenAI 兼容 /v1/chat/completions）。
; 由 LocalLlmClient 读取；未配置时使用内置默认值。
[llm.planner]
endpoint = http://127.0.0.1:8080/v1/chat/completions
model =
temperature = 0.1
max_tokens = 2048
enable_thinking = false
timeout_seconds = 30

; 提示词重写（/生成）使用的本地 LLM；与规划器共用一个 llama-server 也可。
; vram_total_mb = 显卡总显存；vram_need_mb = 跑图所需空闲显存（低于此值时报低显存）。
; vram_used_mb 来自 NVML（整卡占用，含已加载的 LLM 进程）。
[llm.rewriter]
endpoint = http://127.0.0.1:8080/v1/chat/completions
model =
temperature = 0.7
max_tokens = 2048
enable_thinking = false
timeout_seconds = 60
vram_total_mb = 16376
vram_need_mb = 9800
